<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the Windows projects compile on macOS/Linux too (for checks only; they run on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Ashwin Mathias</Company>
    <Product>Screenshot</Product>
    <Copyright>© 2026 Ashwin Mathias · MIT licence</Copyright>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <AppVersion>$([System.IO.File]::ReadAllText('$(RepoRoot)VERSION').Trim())</AppVersion>
    <Version>$(AppVersion)</Version>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <InformationalVersion>$(AppVersion) (build $(BuildNumber))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
